{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Codifier Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/**/*.js"
      ]
    }
  ]
}
