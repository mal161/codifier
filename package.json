{
  "name": "codifier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "check": "turbo run lint typecheck test",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,yaml,yml}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
